# API Gateway URL from the SAM stack output "ApiUrl" (or http://localhost:8000 locally)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cognito values from the SAM stack outputs. Leave empty for local development
# with AUTH_DISABLED=true on the API: the app then skips sign-in.
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Money and date formatting
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN
