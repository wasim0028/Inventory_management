# Copy to terraform.tfvars (git-ignored) for local runs. In GitHub Actions these
# come from environment variables instead (TF_VAR_alert_email, etc.).
#
# Never put the GitHub token in this file. Export it instead:
#   export TF_VAR_github_access_token=ghp_xxx

alert_email = "you@example.com"

