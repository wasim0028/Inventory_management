# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Skip sign-in locally (every request acts as an admin). Ignored on Lambda.
AUTH_DISABLED=true

# Or verify real Cognito tokens locally instead (set AUTH_DISABLED=false):
# COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
